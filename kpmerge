#!/usr/bin/env -S python3 -I
"""Merge two groups of a KeePassXC database (see README.md)."""
import os
import sys

# Checked before importing kpmergelib, whose type annotations need Python 3.10.
if sys.version_info < (3, 10):
    sys.exit("Error: kpmerge requires Python 3.10 or later.")

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import kpmergelib.cli  # noqa: E402

sys.exit(kpmergelib.cli.main())
